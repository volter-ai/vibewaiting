{
  "name": "vibewaiting",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe code without leaving your browser: a lucarne glass widget wired to your CLI coding agent via supercode.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vibewaiting": "dist/cli.js"
  },
  "files": [
    "dist",
    "widget"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node widget/build.mjs",
    "build:widget": "node widget/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.widget.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:widget": "npm run build:widget && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "check:browser": "npm run check && npm run test:widget",
    "smoke": "node scripts/smoke-harness.mjs",
    "smoke:sessions": "npm run build && node scripts/smoke-sessions.mjs"
  },
  "dependencies": {
    "@volter-ai-dev/supercode-client": "^0.3.10",
    "@volter-ai-dev/supercode-harness-sdk": "^0.3.5",
    "@volter-ai-dev/supercode-ui": "^0.1.9",
    "esbuild": "^0.28.2",
    "lucarne": "^1.7.2",
    "preact": "^10.19.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
