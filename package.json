{
  "name": "vibewaiting",
  "version": "0.1.2",
  "private": true,
  "description": "Vibe code without leaving your browser: a messenger overlay wired to local coding-agent sessions through Supercode.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/vibewaiting.git"
  },
  "homepage": "https://github.com/volter-ai/vibewaiting#readme",
  "bugs": {
    "url": "https://github.com/volter-ai/vibewaiting/issues"
  },
  "keywords": [
    "ai-agents",
    "browser-extension",
    "claude-code",
    "codex",
    "developer-tools",
    "terminal"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "bin": {
    "vibewaiting": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSES",
    "NOTICE.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node widget/build.mjs && node extension/build.mjs",
    "build:widget": "node widget/build.mjs",
    "build:extension": "node extension/build.mjs",
    "dev:almostnode": "vite --config experiments/almostnode/vite.config.ts",
    "dev:browser-agent": "vite --config experiments/browser-agent/vite.config.ts",
    "build:browser-agent": "vite build --config experiments/browser-agent/vite.config.ts && node scripts/verify-browser-agent-bundle.mjs",
    "build:rhai-wasm": "node experiments/browser-agent/rhai-wasm/build.mjs",
    "build:conformance": "tsc -p tsconfig.json",
    "conformance:proxy": "npm run build:conformance && node scripts/grok-conformance-proxy.mjs",
    "verify:grok-native-control": "node scripts/verify-grok-native-control-fixture.mjs && node scripts/verify-grok-native-source-map.mjs",
    "typecheck:worker": "tsc -p cloudflare/tsconfig.json",
    "deploy:browser-agent": "node scripts/deploy-browser-agent.mjs",
    "deploy:browser-agent:dry-run": "node scripts/deploy-browser-agent.mjs --dry-run",
    "verify:store-identity": "node scripts/verify-extension-identity.mjs",
    "verify:store-assets": "node scripts/verify-store-assets.mjs",
    "package:release": "node scripts/package-release.mjs",
    "dev:extension": "npm run build && node scripts/dev-extension.mjs",
    "dev:extension:local": "node scripts/sync-local-supercode.mjs && npm run build && node scripts/dev-extension.mjs",
    "sync:local": "node scripts/sync-local-supercode.mjs",
    "sync:local-ui": "npm run sync:local",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.widget.json && tsc -p tsconfig.extension.json && tsc -p tsconfig.test.json && tsc -p experiments/browser-agent/tsconfig.json && npm run typecheck:worker",
    "test": "vitest run",
    "test:widget": "npm run build:widget && playwright test",
    "test:browser-agent-e2e": "npm run build:conformance && playwright test --config playwright.browser-agent.config.mjs",
    "test:browser-agent-e2e:matrix": "npm run test:browser-agent-e2e && BROWSER_AGENT_BROWSER=firefox playwright test --config playwright.browser-agent.config.mjs && BROWSER_AGENT_BROWSER=webkit playwright test --config playwright.browser-agent.config.mjs && BROWSER_AGENT_BROWSER=webkit BROWSER_AGENT_DEVICE='iPhone 15' playwright test --config playwright.browser-agent.config.mjs",
    "check": "npm run verify:store-identity && npm run verify:store-assets && npm run typecheck && npm test && npm audit --audit-level=moderate && npm run build",
    "check:browser": "npm run check && npm run test:widget",
    "check:browser-agent": "npm run typecheck && npm test && npm audit --audit-level=moderate && npm run build:browser-agent && npm run test:browser-agent-e2e",
    "smoke": "node scripts/smoke-harness.mjs",
    "smoke:browser-agent": "node scripts/smoke-browser-agent-deploy.mjs",
    "smoke:sessions": "npm run build && node scripts/smoke-sessions.mjs"
  },
  "dependencies": {
    "@termfleet/terminal": "0.1.9",
    "@volter-ai-dev/supercode-client": "0.3.41",
    "@volter-ai-dev/supercode-harness-sdk": "0.3.18",
    "@volter-ai-dev/supercode-remote-access": "0.2.0",
    "@volter-ai-dev/supercode-terminal": "0.2.13",
    "@volter-ai-dev/supercode-ui": "0.1.66",
    "@volter-ai-dev/widget-shell": "0.4.0",
    "lucarne": "1.7.5",
    "smol-toml": "^1.8.0",
    "ws": "8.21.3",
    "yaml": "^2.9.0"
  },
  "bundleDependencies": [
    "@termfleet/terminal",
    "@volter-ai-dev/supercode-client",
    "@volter-ai-dev/supercode-harness-sdk",
    "@volter-ai-dev/supercode-remote-access",
    "@volter-ai-dev/supercode-terminal",
    "@volter-ai-dev/supercode-ui",
    "@volter-ai-dev/widget-shell",
    "lucarne",
    "ws"
  ],
  "overrides": {
    "vite-plugin-top-level-await": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "@volter/tunnel": "2.0.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "acorn": "^8.18.0",
    "almostnode": "^0.2.14",
    "esbuild": "0.28.2",
    "pdfjs-dist": "^6.2.108",
    "preact": "10.29.8",
    "qrcode-generator": "1.5.2",
    "react-refresh": "^0.14.0",
    "three": "^0.180.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.0"
  }
}
