{
  "name": "vibewaiting",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe code without leaving your browser: a messenger overlay wired to local coding-agent sessions through Supercode.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/vibewaiting.git"
  },
  "homepage": "https://github.com/volter-ai/vibewaiting#readme",
  "bugs": {
    "url": "https://github.com/volter-ai/vibewaiting/issues"
  },
  "keywords": [
    "ai-agents",
    "browser-extension",
    "claude-code",
    "codex",
    "developer-tools",
    "terminal"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vibewaiting": "dist/cli.js"
  },
  "files": [
    "dist",
    "widget"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node widget/build.mjs && node extension/build.mjs",
    "build:widget": "node widget/build.mjs",
    "build:extension": "node extension/build.mjs",
    "dev:extension": "npm run build && node scripts/dev-extension.mjs",
    "dev:extension:local": "node scripts/sync-local-supercode.mjs && npm run build && node scripts/dev-extension.mjs",
    "sync:local": "node scripts/sync-local-supercode.mjs",
    "sync:local-ui": "npm run sync:local",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.widget.json && tsc -p tsconfig.extension.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:widget": "npm run build:widget && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "check:browser": "npm run check && npm run test:widget",
    "smoke": "node scripts/smoke-harness.mjs",
    "smoke:sessions": "npm run build && node scripts/smoke-sessions.mjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@termfleet/terminal": "0.1.9",
    "@volter-ai-dev/supercode-client": "^0.3.24",
    "@volter-ai-dev/supercode-harness-sdk": "^0.3.17",
    "@volter-ai-dev/supercode-remote-access": "^0.1.0",
    "@volter-ai-dev/supercode-terminal": "^0.2.11",
    "@volter-ai-dev/supercode-ui": "^0.1.58",
    "@volter-ai-dev/widget-shell": "0.4.0",
    "@volter/tunnel": "^2.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucarne": "^1.7.5",
    "preact": "^10.19.0",
    "qrcode-generator": "^1.4.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
