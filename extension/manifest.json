{
  "manifest_version": 3,
  "name": "Vibewaiting",
  "version": "0.1.0",
  "description": "Continue local coding-agent sessions from a messenger overlay on any page.",
  "key": "",
  "browser_specific_settings": {
    "gecko": { "id": "vibewaiting@volter.ai" }
  },
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Vibewaiting settings" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app.html", "app.js", "app.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
