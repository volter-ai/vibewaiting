{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibewaiting-browser-agent-sandbox",
  "main": "cloudflare/sandbox-worker.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/browser-agent-spike",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "WORKBENCH_ORIGIN": "https://vibewaiting-browser-agent.aaron-0ed.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
